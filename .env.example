# Copie este arquivo para .env.local (para testar na sua máquina) e/ou
# configure estas mesmas variáveis nas "Environment Variables" do projeto na Vercel.
# NUNCA coloque os valores reais neste arquivo .env.example, nem no Git.

# --- API do WooCommerce (SÓ SERVIDOR — são segredos, nunca vão pro navegador) ---
WC_API_URL=https://4mcinformatica.com
WC_CONSUMER_KEY=coloque_aqui_a_consumer_key_do_woocommerce
WC_CONSUMER_SECRET=coloque_aqui_a_consumer_secret_do_woocommerce

# --- URL pública do WordPress (links de carrinho/conta/páginas legais) ---
# É PÚBLICA (aparece nos links), por isso o prefixo VITE_.
# Quando o WordPress mudar de domínio (ex.: loja.4mcinformatica.com), troque
# SÓ esta variável aqui na Vercel — todos os links do site se atualizam sozinhos.
# Se não for definida, usa https://4mcinformatica.com por padrão.
VITE_WP_STORE_URL=https://4mcinformatica.com
